APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

ADMIN_ROLE=ADMIN
USER_ROLE=USER
CLIENT_ROLE=CLIENT
SUPPORT_PHONE=

SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=
SEED_USER_NAME=Usuario
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_PHONE=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=trabajonautas
DB_USERNAME=root
DB_PASSWORD=

# Base remota del sitio: solo se usa al pulsar Publicar.
SITE_DB_HOST=
SITE_DB_PORT=3306
SITE_DB_DATABASE=
SITE_DB_USERNAME=
SITE_DB_PASSWORD=
SITE_DB_SSL_CA=
# Alternativa: URL MySQL completa si el administrador la proporciona.
SITE_DB_URL=
SITE_PUBLISH_USER_ID=
# Opcional: slug existente de announcement_types; vacío deja el tipo nullable.
SITE_PUBLISH_ANNOUNCEMENT_TYPE_SLUG=
# FTPS explícito (FTP sobre TLS): el host debe coincidir con el certificado TLS.
# SITE_FILES_ROOT es la ruta FTP que corresponde a storage/app/public.
SITE_FILES_HOST=
SITE_FILES_PORT=21
SITE_FILES_USERNAME=
SITE_FILES_PASSWORD=
SITE_FILES_ROOT=
SITE_FILES_TIMEOUT=20

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_RETRY_AFTER=7600
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_VAPID_KEY=

# Conserva descargas válidas entre ejecuciones. Activa refresh sólo para una prueba controlada.
SICOES_REFRESH_DOWNLOADS=false
# No activar silenciosamente en producción: abre Edge visible y requiere intervención humana.
SICOES_ASSISTED_DOWNLOAD=false
SICOES_DOWNLOAD_ATTEMPTS=2
SICOES_DOWNLOAD_ATTEMPT_TIMEOUT_MS=120000
SICOES_REPLAY_TIMEOUT_MS=45000
SICOES_PROCESS_TIMEOUT=7200
SICOES_PROCESS_IDLE_TIMEOUT=240
SICOES_TOKEN_TIMEOUT_MS=60000
SICOES_TABLE_TIMEOUT_MS=60000
SICOES_MANUAL_DOWNLOAD_TIMEOUT_MS=600000
SICOES_MANUAL_DOWNLOAD_DIR=
SICOES_NODE_PATH=
SICOES_PDFTOTEXT_PATH=
SICOES_PDFTOTEXT_TIMEOUT=60
SICOES_BROWSER_PATH=
SICOES_CDP_PORT=9222
SICOES_CDP_URL=http://127.0.0.1:9222

SICOES_AI_PROVIDER=anthropic
SICOES_AI_RETRIES=2
SICOES_AI_TIMEOUT=120
SICOES_AI_MAX_TEXT_CHARS=250000
SICOES_AI_MAX_VISUAL_PDF_BYTES=20971520
SICOES_LOCATION_AUTOMATIC_CONFIDENCE=0.75

# Mantener true; false solo se admite en local/testing.
EVALUAR_VERIFY_SSL=true
EVALUAR_CA_BUNDLE=
EVALUAR_TIMEOUT=30
EVALUAR_CONNECT_TIMEOUT=10
EVALUAR_MAX_REDIRECTS=3

# E-Talent reutiliza el mismo flujo de análisis y previews de Evaluar.
# Mantener true; false solo se admite en local/testing.
ETALENT_VERIFY_SSL=true
ETALENT_CA_BUNDLE=
ETALENT_TIMEOUT=30
ETALENT_CONNECT_TIMEOUT=10
ETALENT_MAX_REDIRECTS=3
ETALENT_FEED_PER_PAGE=100
# En Windows permite validar también contra el almacén nativo (útil con antivirus/proxy TLS).
ETALENT_USE_NATIVE_CA=true

PROFESSION_AUTOMATIC_MATCH_THRESHOLD=0.90
PROFESSION_MANUAL_REVIEW_THRESHOLD=0.75
PROFESSION_DOMINANT_AREA_THRESHOLD=0.70
PROFESSION_AI_AREA_THRESHOLD=0.90
PROFESSION_AMBIGUITY_MARGIN=0.05
PROFESSION_CLASSIFIER_VERSION=profession-catalog-v4
EVALUAR_PROFESSION_PROMPT_VERSION=evaluar-professions-v3

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=4000
ANTHROPIC_TIMEOUT=60
ANTHROPIC_CONNECT_TIMEOUT=10
ANTHROPIC_MAX_DESCRIPTION_CHARS=6000
ANTHROPIC_VERIFY_SSL=true
ANTHROPIC_CA_BUNDLE=
ANTHROPIC_DEBUG_SSL=false
